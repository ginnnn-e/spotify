# ==============================================================================
# THE BARONESS — SPOTIFY TELEGRAM BOT (v2) ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# ==============================================================================

# 1. Spotify Developer Application Credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# 2. Telegram Bot Credentials
# Obtain a token from @BotFather on Telegram
TELEGRAM_ACCESS_TOKEN=your_telegram_bot_token_here

# 3. Access Control & Host Security
# Comma-separated numeric Telegram User IDs allowed in private owner mode.
# The first ID serves as the default Host for Party Mode (/host) and live activity broadcasts.
ALLOWED_TELEGRAM_USER_IDS=123456789

# 4. Optional Tier-3 Lyrics Fallback (Genius API)
# Leave blank to rely on the built-in zero-key LRCLIB + Lyrics.ovh REST engines.
GENIUS_ACCESS_TOKEN=

